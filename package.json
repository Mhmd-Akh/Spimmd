{
  "name": "spimmd-player",
  "version": "1.0.8",
  "description": "Desktop Music Player (spimmd)",
  "author": "Spimmd",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e:dev": "node electron/dev.cjs",
    "e:build": "node electron/build.cjs"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "i18next": "^23.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron-builder": "^25.1.8",
    "rimraf": "^5.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.spimmd.player",
    "productName": "spimmd Player",
    "directories": {
      "output": "FINAL_RELEASES"
    },
    "publish": {
    "provider": "generic",
    "url": "http://upload.hrmtest.ir/files/spimmd-desktop",
    "channel": "latest"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "electron/icon.ico"
    ],
    "electronDist": "./electron-local",
    "electronVersion": "42.1.0",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "sign": null,
      "signDlls": false,
      "signExts": false,
      "publisherName": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spimmd Player",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "deleteAppDataOnUninstall": true
    }
  }
}
